{
  "name": "@astro-soul/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Общие типы, планы и квоты: единственный источник правды по ценам и доступам",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm run gen:contracts:check && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "gen:contracts": "openapi-typescript ../../api.openapi.yaml -o src/contracts/generated.ts",
    "gen:contracts:check": "openapi-typescript ../../api.openapi.yaml -o src/contracts/generated.ts --check"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "openapi-typescript": "^7.13.0"
  }
}
