# Шаблон переменных окружения. Скопируй в .env и заполни локально.
# .env в репозиторий не коммитится (AGENTS.md §8).

# --- Приложение ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:8080

# --- Postgres ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_local_only
POSTGRES_DB=astro_soul
POSTGRES_PORT=5432
DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul
TEST_DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul_test
# Сколько соединений держать в пуле
DATABASE_POOL_MAX=10

# --- Redis (rate-limit, advisory-локи джобов) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
# Токен бота из @BotFather. Ключ подписи initData = HMAC_SHA256("WebAppData", token).
# НЕ КОММИТИТЬ. В проде — только GitHub Secrets / секрет-менеджер.
TELEGRAM_BOT_TOKEN=
# Секрет для пути вебхука + заголовок X-Telegram-Bot-Api-Secret-Token
# Секрет вебхука Telegram: входит в путь и в заголовок X-Telegram-Bot-Api-Secret-Token.
# Если пусто, вебхук закрыт (403) — платёжные апдейты не принимаются.
TELEGRAM_WEBHOOK_SECRET=
# Регистрировать ли вебхук при старте API (итерация 25).
# 1 (по умолчанию) — API сверяет getWebhookInfo с адресом из MINI_APP_URL и
# TELEGRAM_WEBHOOK_SECRET и при расхождении перерегистрирует вебхук сам.
# 0 — адрес регистрирует кто-то снаружи, API только проверяет и пишет в лог.
TELEGRAM_WEBHOOK_AUTO=1
# Базовый URL Bot API. По умолчанию https://api.telegram.org.
# На стенде и в тестах указывать стаб, иначе запросы уйдут в интернет.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Имя бота без @ — из него собирается ссылка шаринга на карту:
# https://t.me/{BOT_USERNAME}?startapp=chart_{chart_id} (контракт 1.4.0, x-bot).
BOT_USERNAME=
# Публичный адрес мини-аппа: по нему бот собирает кнопку «Открыть карту»
# для /start chart_<id>. Пусто — бот молчит, ссылка открывает обычный онбординг.
# Он же — база адреса вебхука: <MINI_APP_URL>/api/v1/internal/telegram/webhook/<secret>.
# Пусто — вебхук не регистрируется вовсе (pre_checkout_query не доставляется).
MINI_APP_URL=
# Telegram id владельца: единственный, кому доступен GET /admin/metrics.
# Пусто — маршрут закрыт для всех (403).
ADMIN_TG_ID=
# Секрет POST /internal/jobs/run (крон). Пусто — маршрут закрыт (403).
# Передаётся заголовком X-Jobs-Secret, не в URL: не оседает в логах прокси.
INTERNAL_JOB_SECRET=
# Перец для детерминированного псевдонима пользователя (>= 32 случайных байта).
# Менять нельзя: смена ломает связь подписок и платежей с пользователем.
PSEUDONYM_PEPPER=

# --- Астро-движок (packages/astro) ---
# fallback — режим до покупки коммерческой лицензии Swiss Ephemeris (AGPL).
# Остальные значения (swisseph) включаются только вместе с лицензией.
ASTRO_ENGINE=fallback
# Каталог с файлами Swiss Ephemeris (.se1). Используется только при ASTRO_ENGINE=swisseph.
# В fallback-режиме (Moshier) не нужен; Хирон без seas_18.se1 не считается.
SE_EPHE_PATH=
# Локальный HTTP-сайдкар движка. Если пусто — API отвечает 503 на /charts и пишет
# в /health `astro: down` (сам процесс при этом работает).
ASTRO_SERVICE_URL=http://127.0.0.1:8001
# Порт, на котором поднимается сайдкар (`python -m astro.service`).
ASTRO_PORT=8001

# --- Геоданные (geo.md) ---
# bundled — только локальный справочник, без сети (по умолчанию).
# nominatim — фолбэк к внешнему сервису, когда в справочнике ничего не нашлось
# или нашлось меньше трёх кандидатов.
GEO_PROVIDER=bundled
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Контакт для User-Agent (требование политики Nominatim). Обязателен при nominatim.
GEO_CONTACT_EMAIL=
# Таймаут запроса к Nominatim, мс (geo.md: 2 с).
GEO_NOMINATIM_TIMEOUT_MS=2000
# Политика Nominatim: не больше одного запроса в секунду на процесс.
GEO_NOMINATIM_MIN_INTERVAL_MS=1000
# Кэш ответов Nominatim: 24 часа (geo.md).
GEO_CACHE_TTL_SECONDS=86400
# Порог доверия к поясу «по ближайшему городу», км. Дальше — города нет.
GEO_TZ_MAX_DISTANCE_KM=300
# Сколько кандидатов справочника считается достаточным ответом.
GEO_MIN_LOCAL_CANDIDATES=3

# --- Границы поиска городов ---
# Меняются только здесь, на сервере: клиент не хранит свою копию чисел и
# получает две нужные ему границы из `GET /me` (`limits.geo_min_query_length`,
# `limits.geo_max_query_length`). `VITE_*` для этого не заводим — вторая копия
# разошлась бы с серверной, и человек получал бы 422 на длине, которую
# интерфейс считает допустимой.
# Минимальная длина запроса к `POST /geo/resolve`; короче — 422.
GEO_MIN_QUERY_LENGTH=2
# Максимальная длина запроса; длиннее — 422.
GEO_MAX_QUERY_LENGTH=120
# Сколько кандидатов отдавать, если `limit` не передан.
GEO_DEFAULT_LIMIT=5
# Потолок `limit`: больше — молча зажимаем до этого числа (не 422).
GEO_MAX_LIMIT=10

# Кэш геоподсказок живёт в Redis выше (REDIS_URL); пусто — в памяти процесса.

# Актуальная редакция согласия на обработку ПДн (контракт 1.4.0).
# Устаревшую версию сервер отклоняет: 422 + field_errors[consent.version].
CONSENT_VERSION=2026-11-10

# --- Лимиты запросов (в минуту, на пользователя) ---
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_CHARTS_PER_MIN=10
RATE_LIMIT_GEO_PER_MIN=120

# --- LLM: GigaChat (разбор личности) ---
# Basic-ключ авторизации из личного кабинета. Нет ключа — работает подставной
# провайдер, и это видно: llm_fake_provider в логе и model=fake-llm в БД.
GIGACHAT_AUTH_KEY=
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# Владелец: PERS. Значение по умолчанию — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# CA-бандл НУЦ Минцифры: путь к файлу. Обязателен для https.
# TLS-проверка не отключается никогда — нет файла, нет вызова.
GIGACHAT_CA_BUNDLE=

# Модель и её цена берутся из одной таблицы (apps/api/src/config/llm-models.ts):
# GigaChat-3-Ultra — 0.5 ₽/1000 токенов, GigaChat-2-Max — 0.65 ₽/1000.
# Неизвестная модель не поднимает сервис: цены для неё нет.
LLM_MODEL=GigaChat-3-Ultra
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_MS=60000
# Потолки расходов: 80 ₽ на разбор (решение владельца), 2000 ₽ в месяц.
LLM_REPORT_CAP_RUB=80
# Два раздельных месячных потолка (итерация 10): разбор стоит 23–30 ₽ и
# продаётся разово, прогноз — 1,2–1,6 ₽ и генерируется каждый день всем.
# Общий лимит позволял ночным прогнозам съесть бюджет уже проданных разборов.
LLM_MONTHLY_CAP_RUB_REPORT=2000
LLM_MONTHLY_CAP_RUB_FORECAST=2000
# 1 — принудительно подставной провайдер (разработка, демо).
LLM_FAKE=0
# Автовозврат звёзд за неудавшийся разбор (джоб report_refund).
# Решение владельца: автовозврата нет. 1 — включить осознанно (стенд).
REFUND_ON_REPORT_FAILED=0
# Circuit breaker разборов: три провала валидации подряд закрывают приём новых
# разборов на 30 минут (POST /reports → 503 report_breaker_open).
# 1 — как в проде (единственное допустимое значение на проде).
# 0 — брейкер не блокирует запуск: только для ручных прогонов при починке
#     промпта. Лимит попыток, валидаторы и лимиты стоимости не меняются.
# Мусор (true, 2, пустая строка) — ошибка старта, а не молчаливый дефолт.
REPORT_BREAKER_ENABLED=1
# Потолок стоимости одной совместимости (синастрия, контракт 1.6.0), рубли.
# Товар за 249 ⭐ — это четыре раздела на 2 400–3 150 знаков, то есть около
# трети разбора; 25 ₽ — «полторы попытки всех разделов» при 0,5 ₽/1000.
LLM_COMPAT_CAP_RUB=25
# Брейкер совместимости — свой и от разбора не зависит: ни один не закрывает
# другой. Счётчик считает только провалы совместимости.
# 1 — как в проде; 0 — не блокировать запуск (ручные прогоны при починке).
COMPAT_BREAKER_ENABLED=1

# ── Прогноз дня и «спроси карту» (итерация 30, контракт 1.6.6) ──────────────
# Решения владельца; меняются здесь, а не правкой кода.
#
# Прогноз дня целиком — по подписке. 0 — отдавать всем (только стенд).
FORECAST_REQUIRES_SUBSCRIPTION=1
# Без подписки — одна детерминированная строка (знак Луны и фаза), без вызова
# модели. Человек должен видеть, что прогноз существует, а не пустой экран.
FORECAST_FREE_FACTS=1
# Потолок на один прогноз дня, рубли (≈1,1 ₽ за вызов на 900–1400 знаков).
LLM_DAILY_FORECAST_CAP_RUB=3
# Вопросов в сутки подписчику, по местной дате места рождения.
QUESTION_DAILY_LIMIT=3
# Вопросы без подписки: 0 — 403 subscription_required (решение владельца).
QUESTION_FOR_NON_SUBSCRIBERS=0
# Потолок на один ответ (≈0,7 ₽) и дневной потолок на человека.
LLM_QUESTION_CAP_RUB=3
LLM_QUESTION_DAILY_CAP_RUB=15
# Таймаут генерации прогноза (25 с — решение владельца) и пауза перед
# повтором после провала или таймаута (60 с). В тестах уменьшаются, чтобы не
# ждать полминуты на каждый прогон.
FORECAST_TIMEOUT_MS=25000
FORECAST_RETRY_SECONDS=60
# Версии промптов — отдельные от разбора и совместимости.
PROMPT_VERSION_FORECAST=prompts_v1.0
PROMPT_VERSION_QUESTION=prompts_v1.0
# Версия астро-движка: 1.1.0 — сайдкар считает факты дня. Старые прогнозы не
# пересчитываются, у строки `daily_forecasts` своя версия.
ENGINE_VERSION=1.1.0

# ── PDF разбора и карточки шеринга (итерация 32, контракт 1.6.8) ─────────────
# Файлы лежат приватно: каталог не отдаётся статикой, единственный вход —
# подписанная ссылка на нашем домене. Прямых адресов хранилища наружу нет.
#
# Каталог хранилища. В docker-compose это том `files-data`; вне его — путь
# относительно рабочего каталога API. Каталог должен переживать деплой, иначе
# строки `report_pdfs` будут ссылаться на несуществующие файлы.
FILE_STORAGE_DIR=var/storage
# Секрет подписи ссылок. Пусто — берётся производный от PSEUDONYM_PEPPER
# (`file-signing:<pepper>`). Отдельный секрет нужен, чтобы ротация подписи
# файлов не ломала псевдонимизацию пользователей и наоборот.
FILE_SIGNING_SECRET=
# Срок жизни подписанной ссылки, секунды. 24 часа — как в задании: PDF
# пересылают в чат, но вечная ссылка на платный документ недопустима.
FILE_URL_TTL_SECONDS=86400
# Публичный адрес API: по нему собираются абсолютные ссылки на файлы (их
# вставляет Telegram). Пусто — ссылки относительные (годно для локального
# стенда и мини-аппа того же origin).
PUBLIC_API_URL=
# Потолок размера PDF, байты. 12 МБ: при переполнении качество колеса
# понижается (scale 1 → 0.6 → 0.35 → без картинки), а не падает сборка.
PDF_MAX_BYTES=12582912
# Таймаут сборки PDF в сайдкаре, мс. Сборка — CPU-работа (reportlab + Pillow),
# модель не вызывается, поэтому стоимость в рублях — ноль.
PDF_BUILD_TIMEOUT_MS=60000
