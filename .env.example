# Шаблон переменных окружения. Скопируй в .env и заполни локально.
# .env в репозиторий не коммитится (AGENTS.md §8).

# --- Приложение ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:8080

# --- Postgres ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_local_only
POSTGRES_DB=astro_soul
POSTGRES_PORT=5432
DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul
TEST_DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul_test
# Сколько соединений держать в пуле
DATABASE_POOL_MAX=10

# --- Redis (rate-limit, advisory-локи джобов) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
# Токен бота из @BotFather. Ключ подписи initData = HMAC_SHA256("WebAppData", token).
# НЕ КОММИТИТЬ. В проде — только GitHub Secrets / секрет-менеджер.
TELEGRAM_BOT_TOKEN=
# Секрет для пути вебхука + заголовок X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Перец для детерминированного псевдонима пользователя (>= 32 случайных байта).
# Менять нельзя: смена ломает связь подписок и платежей с пользователем.
PSEUDONYM_PEPPER=

# --- Астро-движок (packages/astro) ---
# fallback — режим до покупки коммерческой лицензии Swiss Ephemeris (AGPL).
# Остальные значения (swisseph) включаются только вместе с лицензией.
ASTRO_ENGINE=fallback
# Каталог с файлами Swiss Ephemeris (.se1). Используется только при ASTRO_ENGINE=swisseph.
# В fallback-режиме (Moshier) не нужен; Хирон без seas_18.se1 не считается.
SE_EPHE_PATH=
ASTRO_SERVICE_URL=http://localhost:8001

# --- LLM ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_PLAN=
LLM_MODEL_CHAPTERS=
# Жёсткий потолок стоимости одного разбора, USD
LLM_MAX_REPORT_COST_USD=0.35
