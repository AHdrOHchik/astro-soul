# Шаблон переменных окружения. Скопируй в .env и заполни локально.
# .env в репозиторий не коммитится (AGENTS.md §8).

# --- Приложение ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:8080

# --- Postgres ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_local_only
POSTGRES_DB=astro_soul
POSTGRES_PORT=5432
DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul
TEST_DATABASE_URL=postgres://astro:astro_local_only@localhost:5432/astro_soul_test
# Сколько соединений держать в пуле
DATABASE_POOL_MAX=10

# --- Redis (rate-limit, advisory-локи джобов) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
# Токен бота из @BotFather. Ключ подписи initData = HMAC_SHA256("WebAppData", token).
# НЕ КОММИТИТЬ. В проде — только GitHub Secrets / секрет-менеджер.
TELEGRAM_BOT_TOKEN=
# Секрет для пути вебхука + заголовок X-Telegram-Bot-Api-Secret-Token
# Секрет вебхука Telegram: входит в путь и в заголовок X-Telegram-Bot-Api-Secret-Token.
# Если пусто, вебхук закрыт (403) — платёжные апдейты не принимаются.
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @ — из него собирается ссылка шаринга на карту:
# https://t.me/{BOT_USERNAME}?startapp=chart_{chart_id} (контракт 1.4.0, x-bot).
BOT_USERNAME=
# Публичный адрес мини-аппа: по нему бот собирает кнопку «Открыть карту»
# для /start chart_<id>. Пусто — бот молчит, ссылка открывает обычный онбординг.
MINI_APP_URL=
# Telegram id владельца: единственный, кому доступен GET /admin/metrics.
# Пусто — маршрут закрыт для всех (403).
ADMIN_TG_ID=
# Секрет POST /internal/jobs/run (крон). Пусто — маршрут закрыт (403).
# Передаётся заголовком X-Jobs-Secret, не в URL: не оседает в логах прокси.
INTERNAL_JOB_SECRET=
# Перец для детерминированного псевдонима пользователя (>= 32 случайных байта).
# Менять нельзя: смена ломает связь подписок и платежей с пользователем.
PSEUDONYM_PEPPER=

# --- Астро-движок (packages/astro) ---
# fallback — режим до покупки коммерческой лицензии Swiss Ephemeris (AGPL).
# Остальные значения (swisseph) включаются только вместе с лицензией.
ASTRO_ENGINE=fallback
# Каталог с файлами Swiss Ephemeris (.se1). Используется только при ASTRO_ENGINE=swisseph.
# В fallback-режиме (Moshier) не нужен; Хирон без seas_18.se1 не считается.
SE_EPHE_PATH=
# Локальный HTTP-сайдкар движка. Если пусто — API отвечает 503 на /charts и пишет
# в /health `astro: down` (сам процесс при этом работает).
ASTRO_SERVICE_URL=http://127.0.0.1:8001
# Порт, на котором поднимается сайдкар (`python -m astro.service`).
ASTRO_PORT=8001

# --- Геоданные (geo.md) ---
# bundled — только локальный справочник, без сети (по умолчанию).
# nominatim — фолбэк к внешнему сервису, когда в справочнике ничего не нашлось.
GEO_PROVIDER=bundled
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Контакт для User-Agent (требование политики Nominatim). Обязателен при nominatim.
GEO_CONTACT_EMAIL=

# Актуальная редакция согласия на обработку ПДн (контракт 1.4.0).
# Устаревшую версию сервер отклоняет: 422 + field_errors[consent.version].
CONSENT_VERSION=2026-11-10

# --- Лимиты запросов (в минуту, на пользователя) ---
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_CHARTS_PER_MIN=10
RATE_LIMIT_GEO_PER_MIN=120

# --- LLM: GigaChat (разбор личности) ---
# Basic-ключ авторизации из личного кабинета. Нет ключа — работает подставной
# провайдер, и это видно: llm_fake_provider в логе и model=fake-llm в БД.
GIGACHAT_AUTH_KEY=
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# Владелец: PERS. Значение по умолчанию — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# CA-бандл НУЦ Минцифры: путь к файлу. Обязателен для https.
# TLS-проверка не отключается никогда — нет файла, нет вызова.
GIGACHAT_CA_BUNDLE=

# Модель и её цена берутся из одной таблицы (apps/api/src/config/llm-models.ts):
# GigaChat-3-Ultra — 0.5 ₽/1000 токенов, GigaChat-2-Max — 0.65 ₽/1000.
# Неизвестная модель не поднимает сервис: цены для неё нет.
LLM_MODEL=GigaChat-3-Ultra
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_MS=60000
# Потолки расходов: 80 ₽ на разбор (решение владельца), 2000 ₽ в месяц.
LLM_REPORT_CAP_RUB=80
LLM_MONTHLY_CAP_RUB=2000
# 1 — принудительно подставной провайдер (разработка, демо).
LLM_FAKE=0
