# Origin of the API, without the /api/v1 suffix. Empty = same origin
# (in dev the Vite server proxies /api to API_PROXY_TARGET).
VITE_API_BASE_URL=

# --- dev server only (read by vite.config.ts, never shipped to the bundle) ---
# Where `vite dev` proxies /api when the mock is off.
API_PROXY_TARGET=http://localhost:8080
# 1 = serve the contract-shaped mock from ./mock instead of proxying.
API_MOCK=0
# Artificial latency of the mock, ms.
API_MOCK_DELAY=400
# Scenario for GET /me in the mock: returning | 401 | 500. Anything else = a new user.
API_MOCK_ME=

# --- dev builds only ---
# Raw initData string to send as X-Telegram-Init-Data when the app is opened
# outside Telegram (plain browser). A production build does not contain it:
# `pnpm build` fails if it does. The string signs in as its user: take it from
# a test account only and keep it in .env (git-ignored), never in this file.
VITE_DEV_INIT_DATA=
