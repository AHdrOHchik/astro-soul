# Origin of the API, without the /api/v1 suffix. Empty = same origin
# (in dev the Vite server proxies /api to API_PROXY_TARGET).
VITE_API_BASE_URL=

# Username of the bot the Mini App is opened from, with or without @. A shared chart then
# carries a link to it: https://t.me/<username>?startapp=chart_<chart_id> (the contract's
# x-bot.share_link_template). Empty = the picture and the text go out without a link.
# Anything that is not a username stops the build.
VITE_BOT_USERNAME=

# Where «Написать в поддержку» leads: a Telegram username (with or without @) or an https
# link. Empty = the button is shown disabled, as «Поддержка скоро появится». Anything else
# stops the build.
VITE_SUPPORT_CONTACT=

# --- dev server only (read by vite.config.ts, never shipped to the bundle) ---
# Where `vite dev` proxies /api when the mock is off.
API_PROXY_TARGET=http://localhost:8080
# 1 = serve the contract-shaped mock from ./mock instead of proxying.
API_MOCK=0
# Artificial latency of the mock, ms.
API_MOCK_DELAY=400
# Who the mock's user is, words separated by commas: 401 | 500 (GET /me fails) | returning
# (already has a chart: the app opens on it) | paid (a chart and the full report bought for
# it) | subscriber (a chart and a monthly subscription). Empty = a new user. The mock
# remembers what happens to its user until it is restarted or reset
# (GET /api/v1/__mock/reset?me=paid&report=failed starts it over with another scenario).
API_MOCK_ME=
# How every report of the mock ends: ready (default) | failed | refunded | stuck.
API_MOCK_REPORT=
# How long one chapter of a mock report takes, ms. Empty = 2500.
API_MOCK_REPORT_CHAPTER_MS=
# POST /billing/invoice in the mock: 422 | 500 | price (the invoice is dearer than expected).
API_MOCK_INVOICE=
# DELETE /me in the mock: 409 | 401 | 500. Empty = everything is deleted.
API_MOCK_DELETE=
# 1 = a finished mock report has a PDF to download (apps/api makes none yet).
API_MOCK_PDF=
# Consent version the mock accepts in POST /charts. Empty = the version of the app's own
# texts. Another date plays a server with newer texts: every chart request is refused
# by `consent.version`, and the app reloads itself.
API_MOCK_CONSENT_VERSION=

# --- dev builds only ---
# Raw initData string to send as X-Telegram-Init-Data when the app is opened
# outside Telegram (plain browser). A production build does not contain it:
# `pnpm build` fails if it does. The string signs in as its user: take it from
# a test account only and keep it in .env (git-ignored), never in this file.
VITE_DEV_INIT_DATA=
# How a pretended invoice ends in a plain browser: paid | cancelled | failed | pending.
# With `paid` the dev build also tells the mock that the invoice is paid, so the screens
# after a purchase can be walked without Telegram. Empty = no pretending: the paywall says
# that payment needs Telegram. A production build does not contain it either.
VITE_DEV_INVOICE=
